;; hyperjay — a jacquard loom for jolt-microvm. Weave cards into a warp of
;; live microVMs and work the circuit box from a GTK4 bench.
;;
;; Deps are pinned to exact git shas. jolt-microvm brings jolt-libkrun,
;; jolt-exec, jolt-pty, jolt-tapmasq and jolt-oci transitively; glimmer and
;; glimmer-gtk are the bench's reactive core and GTK4 backend.
{:jolt/min-version "0.8.28"

 :paths ["src"]

 :deps {racklr-dev/jolt-microvm
        {:git/url "https://github.com/racklr-dev/jolt-microvm"
         :git/sha "07eadaab4ae33eb188760741a3162f8ef6d6af57"}
        ;; Pin jolt-oci directly so the wizard's tags/list helper resolves to the
        ;; version that has it (jolt-microvm's transitive pin predates it).
        jolt-lang/jolt-oci
        {:git/url "https://github.com/racklr-dev/jolt-oci"
         :git/sha "796a8f936963546f38ea1a642aa94dc1b19f9bff"}
        jolt-lang/glimmer
        {:git/url "https://github.com/jolt-lang/glimmer"
         :git/sha "a61f5ef71f56033c7a6765f400a5978ee76b7b6b"}
        jolt-lang/glimmer-gtk
        {:git/url "https://github.com/jolt-lang/glimmer-gtk"
         :git/sha "3d46afcd1f0c50d26483dd8e20f76cb3433602a6"}
        ;; glimmer-gl supplies the :gl-area widget (GtkGLArea) and the native GL
        ;; bindings the embedded canvas uploads the guest framebuffer into.
        jolt-lang/glimmer-gl
        {:git/url "https://github.com/jolt-lang/glimmer-gl"
         :git/sha "8e74cdf6da29e9f2a9f093c07cbd45a307b5101c"}}

 :tasks {gui        "jolt run -m jolt.hyperjay"
         x11        "jolt run cards/desktop-x11.clj"
         wayland    "jolt run cards/desktop-wayland.clj"
         single-app "jolt run cards/single-app.clj"}}